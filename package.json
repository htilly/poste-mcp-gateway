{
  "name": "poste-mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP gateway into poste.io mailboxes. Users sign in with their own IMAP credentials over OAuth 2.1.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.5",
    "@types/turndown": "5.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
