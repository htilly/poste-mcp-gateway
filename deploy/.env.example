# Copy to .env and chmod 600. Site-specific values live only here, never in git.

# Public name and port of the gateway. Claude connects to https://PUBLIC_HOST:PUBLIC_PORT/mcp
PUBLIC_HOST=mail.example.com
PUBLIC_PORT=8443

# poste.io IMAP host. Its TLS certificate is checked against this name.
IMAP_HOST=mail.example.com
# Address the gateway dials for IMAP_HOST. Default host-gateway: poste.io runs
# on this same host. Set an IP only if poste.io lives elsewhere.
# IMAP_HOST_IP=203.0.113.10

# Let's Encrypt account email for Caddy.
ACME_EMAIL=admin@example.com

# Comma-separated mailbox addresses allowed to sign in.
ALLOWED_USERS=alice@example.com,bob@example.com

# Addresses that may be granted "send" (a subset of ALLOWED_USERS). Empty = nobody can send.
SEND_USERS=
# draft (default): mail to addresses this mailbox never sent to goes to Drafts. allow: send anyway.
# SEND_NEW_RECIPIENTS=draft
# SEND_LIMIT_PER_HOUR=10

# Images built by CI (ghcr.io). Pin a version and read CHANGELOG.md before bumping it:
# a new version can add capabilities. (latest and sha-xxxxxxx also exist.)
# IMAGE_REPO=ghcr.io/htilly/poste-mcp-gateway
IMAGE_TAG=0.3.0
